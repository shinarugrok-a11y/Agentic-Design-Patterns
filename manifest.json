{
  "version": "1.0",
  "source": "Agentic Design Patterns (Gulli)",
  "skills": [
    {"id":"prompt-chaining","name":"Prompt Chaining","chapter":1,"role":["executor"],"when_to_use":"Chain ordered stages; feed output forward.","when_not_to_use":"Independent subtasks.","inputs":["stage prompts","payload"],"outputs":["final output"],"failure_modes":["early error cascades","drift, no checkpoints"],"chains_with":["routing","tool-use"],"token_cost_estimate":225},
    {"id":"routing","name":"Routing","chapter":2,"role":["planner","executor"],"when_to_use":"Dispatch request types to specialists.","when_not_to_use":"Single fixed pipeline.","inputs":["request","route table"],"outputs":["specialist reply"],"failure_modes":["misclassification","missing fallback"],"chains_with":["prompt-chaining","multi-agent"],"token_cost_estimate":236},
    {"id":"parallelization","name":"Parallelization","chapter":3,"role":["executor"],"when_to_use":"Fan out independent subtasks.","when_not_to_use":"Outputs depend on each other.","inputs":["subtask list","join prompt"],"outputs":["merged result"],"failure_modes":["slow branch stalls join","unbounded fan-out"],"chains_with":["routing","multi-agent"],"token_cost_estimate":209},
    {"id":"reflection","name":"Reflection","chapter":4,"role":["critic"],"when_to_use":"Draft, critique, refine to PASS.","when_not_to_use":"No critic rubric exists.","inputs":["draft","rubric"],"outputs":["refined output"],"failure_modes":["agreeable critic","no stop rule"],"chains_with":["evaluation-monitoring","planning"],"token_cost_estimate":239},
    {"id":"tool-use","name":"Tool Use","chapter":5,"role":["executor"],"when_to_use":"Call typed tools for live data/actions.","when_not_to_use":"Answer is in-context.","inputs":["tool schemas","query"],"outputs":["grounded answer"],"failure_modes":["wrong tool chosen","uncapped call loops"],"chains_with":["mcp","exception-handling"],"token_cost_estimate":212},
    {"id":"planning","name":"Planning","chapter":6,"role":["planner"],"when_to_use":"Decompose goal into ordered steps.","when_not_to_use":"Single-step task.","inputs":["goal","actions"],"outputs":["step plan"],"failure_modes":["missed dependency","no replan trigger"],"chains_with":["multi-agent","reflection"],"token_cost_estimate":203},
    {"id":"multi-agent","name":"Multi-Agent Collaboration","chapter":7,"role":["planner","executor"],"when_to_use":"Coordinate role specialists.","when_not_to_use":"One agent suffices.","inputs":["role roster","topology"],"outputs":["combined result"],"failure_modes":["unclear ownership","loop never exits"],"chains_with":["planning","evaluation-monitoring"],"token_cost_estimate":218},
    {"id":"memory-management","name":"Memory Management","chapter":8,"role":["memory"],"when_to_use":"Recall facts across turns.","when_not_to_use":"Single-turn task.","inputs":["session id","facts"],"outputs":["recalled context"],"failure_modes":["unbounded history","stale overrides fresh"],"chains_with":["knowledge-retrieval","mcp"],"token_cost_estimate":219},
    {"id":"learning-adaptation","name":"Learning and Adaptation","chapter":9,"role":["memory","critic"],"when_to_use":"Evolve policy from feedback.","when_not_to_use":"One-off, no feedback.","inputs":["policy","fitness fn"],"outputs":["adapted policy"],"failure_modes":["overfits latest feedback","noisy fitness"],"chains_with":["evaluation-monitoring","reflection"],"token_cost_estimate":205},
    {"id":"mcp","name":"Model Context Protocol (MCP)","chapter":10,"role":["memory","executor"],"when_to_use":"Share tools via standard server.","when_not_to_use":"One-off local function.","inputs":["server def","client config"],"outputs":["MCP agent"],"failure_modes":["schema mismatch","over-permissive server"],"chains_with":["tool-use","memory-management"],"token_cost_estimate":225},
    {"id":"goal-setting","name":"Goal Setting and Monitoring","chapter":11,"role":["planner"],"when_to_use":"Iterate until checkable goals pass.","when_not_to_use":"Success is subjective.","inputs":["goal list","max iters"],"outputs":["passing artifact"],"failure_modes":["vague goals","false-pass stops loop"],"chains_with":["evaluation-monitoring","reflection"],"token_cost_estimate":210},
    {"id":"exception-handling","name":"Exception Handling and Recovery","chapter":12,"role":["safety"],"when_to_use":"Retry, fallback, or degrade.","when_not_to_use":"Failure is deterministic.","inputs":["retry policy","fallbacks"],"outputs":["recovered result"],"failure_modes":["retrying fatal errors","silent degraded answers"],"chains_with":["tool-use","guardrails-safety"],"token_cost_estimate":206},
    {"id":"human-in-the-loop","name":"Human-in-the-Loop","chapter":13,"role":["safety"],"when_to_use":"Escalate risky actions to humans.","when_not_to_use":"Low-risk reversible step.","inputs":["triggers","human channel"],"outputs":["decision + trail"],"failure_modes":["mis-tuned threshold","context-free escalation"],"chains_with":["guardrails-safety","goal-setting"],"token_cost_estimate":220},
    {"id":"knowledge-retrieval","name":"Knowledge Retrieval (RAG)","chapter":14,"role":["memory"],"when_to_use":"Retrieve, then answer with cites.","when_not_to_use":"Model already knows it.","inputs":["query","corpus"],"outputs":["cited answer"],"failure_modes":["irrelevant chunks","stale index"],"chains_with":["memory-management","tool-use"],"token_cost_estimate":223},
    {"id":"inter-agent-a2a","name":"Inter-Agent Communication (A2A)","chapter":15,"role":["executor","planner"],"when_to_use":"Link agents across services.","when_not_to_use":"Same-process agents.","inputs":["AgentCard","request"],"outputs":["remote result"],"failure_modes":["false AgentCard","auth misconfig"],"chains_with":["multi-agent","mcp"],"token_cost_estimate":209},
    {"id":"resource-optimization","name":"Resource-Aware Optimization","chapter":16,"role":["planner"],"when_to_use":"Cheapest sufficient model per prompt.","when_not_to_use":"All need frontier quality.","inputs":["prompt","model tiers"],"outputs":["answer + cost log"],"failure_modes":["under-routed hard prompts","no quality fallback"],"chains_with":["routing","evaluation-monitoring"],"token_cost_estimate":203},
    {"id":"reasoning-techniques","name":"Reasoning Techniques","chapter":17,"role":["critic"],"when_to_use":"CoT, self-correct, or execute code.","when_not_to_use":"Simple lookup or style task.","inputs":["problem","technique"],"outputs":["answer + trace"],"failure_modes":["convincing wrong CoT","unverified flips"],"chains_with":["reflection","tool-use"],"token_cost_estimate":209},
    {"id":"guardrails-safety","name":"Guardrails and Safety","chapter":18,"role":["safety"],"when_to_use":"Gate input, tools, and output.","when_not_to_use":"Trusted internal batch.","inputs":["policy rules","gate points"],"outputs":["allow/block verdict"],"failure_modes":["over-blocking","injectable judge"],"chains_with":["human-in-the-loop","evaluation-monitoring"],"token_cost_estimate":219},
    {"id":"evaluation-monitoring","name":"Evaluation and Monitoring","chapter":19,"role":["critic"],"when_to_use":"Score outputs; monitor live.","when_not_to_use":"No ground truth exists.","inputs":["outputs","rubric"],"outputs":["scores + alerts"],"failure_modes":["judge loves verbosity","no baseline"],"chains_with":["reflection","goal-setting"],"token_cost_estimate":203},
    {"id":"prioritization","name":"Prioritization","chapter":20,"role":["planner"],"when_to_use":"Order backlog by value.","when_not_to_use":"Single task or FIFO.","inputs":["task list","scoring rule"],"outputs":["ordered queue"],"failure_modes":["stale priorities","everything becomes P0"],"chains_with":["planning","multi-agent"],"token_cost_estimate":188},
    {"id":"exploration-discovery","name":"Exploration and Discovery","chapter":21,"role":["planner","critic"],"when_to_use":"Hypothesize, verify, converge.","when_not_to_use":"Answer is known.","inputs":["question","budget"],"outputs":["ranked findings"],"failure_modes":["unbounded exploration","weak reviewers"],"chains_with":["reasoning-techniques","evaluation-monitoring"],"token_cost_estimate":203}
  ]
}
