{
  "version": "1.0",
  "source": "Agentic Design Patterns (Gulli)",
  "skills": [
    {"id":"prompt-chaining","name":"Prompt Chaining","chapter":1,"role":["executor"],"when_to_use":"Chain prompts when each stage feeds the next.","when_not_to_use":"Independent or one-shot tasks.","inputs":["raw input","stage prompts"],"outputs":["final artifact"],"failure_modes":["error propagates","context lost"],"chains_with":["routing","tool-use"],"token_cost_estimate":227},
    {"id":"routing","name":"Routing","chapter":2,"role":["planner","executor"],"when_to_use":"Classify a request, dispatch one handler.","when_not_to_use":"Single fixed path.","inputs":["request","handler descriptions"],"outputs":["handler result"],"failure_modes":["silent misroute","no default branch"],"chains_with":["multi-agent","resource-aware-optimization"],"token_cost_estimate":219},
    {"id":"parallelization","name":"Parallelization","chapter":3,"role":["executor"],"when_to_use":"Run independent branches concurrently, then merge.","when_not_to_use":"Dependent steps.","inputs":["shared input","branches"],"outputs":["merged result"],"failure_modes":["slow branch blocks join","merge hallucinates"],"chains_with":["multi-agent","prompt-chaining"],"token_cost_estimate":210},
    {"id":"reflection","name":"Reflection","chapter":4,"role":["critic"],"when_to_use":"Critique a draft, refine until criteria pass.","when_not_to_use":"Cheap outputs, no criteria.","inputs":["task + criteria","draft"],"outputs":["refined output"],"failure_modes":["no stop condition","shared blind spots"],"chains_with":["evaluation-monitoring","goal-setting"],"token_cost_estimate":229},
    {"id":"tool-use","name":"Tool Use","chapter":5,"role":["executor"],"when_to_use":"Call typed functions for live data or actions.","when_not_to_use":"Answer is in-context.","inputs":["tool schemas","request"],"outputs":["grounded answer"],"failure_modes":["vague docstring","string errors as data"],"chains_with":["mcp","exception-handling"],"token_cost_estimate":225},
    {"id":"planning","name":"Planning","chapter":6,"role":["planner"],"when_to_use":"Decompose a goal into ordered steps first.","when_not_to_use":"Single action or fixed pipeline.","inputs":["goal","tools"],"outputs":["ordered plan"],"failure_modes":["missing step","never revised"],"chains_with":["goal-setting","multi-agent"],"token_cost_estimate":218},
    {"id":"multi-agent","name":"Multi-Agent Collaboration","chapter":7,"role":["planner","executor"],"when_to_use":"Split work across specialist agents.","when_not_to_use":"One agent with tools suffices.","inputs":["roles","coordination model"],"outputs":["combined result"],"failure_modes":["coordinator answers itself","state key mismatch"],"chains_with":["a2a","routing"],"token_cost_estimate":234},
    {"id":"memory-management","name":"Memory Management","chapter":8,"role":["memory"],"when_to_use":"Keep session state and searchable long-term memory.","when_not_to_use":"Stateless one-shot requests.","inputs":["session id","state updates"],"outputs":["state + recall"],"failure_modes":["direct state mutation","history overflow"],"chains_with":["rag","learning-adaptation"],"token_cost_estimate":215},
    {"id":"learning-adaptation","name":"Learning and Adaptation","chapter":9,"role":["memory","critic"],"when_to_use":"Improve behaviour from scored outcomes.","when_not_to_use":"Fixed behaviour, no evaluator.","inputs":["scored episodes","mutable artifact"],"outputs":["improved artifact"],"failure_modes":["reward hacking","broken self-edit"],"chains_with":["evaluation-monitoring","reflection"],"token_cost_estimate":204},
    {"id":"mcp","name":"Model Context Protocol","chapter":10,"role":["memory","executor"],"when_to_use":"Discover tools via an MCP server.","when_not_to_use":"A few local functions.","inputs":["server url/command","tool_filter"],"outputs":["tool results"],"failure_modes":["relative server path","no tool_filter"],"chains_with":["a2a","exception-handling"],"token_cost_estimate":226},
    {"id":"goal-setting","name":"Goal Setting and Monitoring","chapter":11,"role":["planner"],"when_to_use":"Define measurable goals, loop until judged met.","when_not_to_use":"Success is undefinable.","inputs":["goals","judge"],"outputs":["per-goal status"],"failure_modes":["judge not boolean","conflicting goals"],"chains_with":["reflection","prioritization"],"token_cost_estimate":217},
    {"id":"exception-handling","name":"Exception Handling and Recovery","chapter":12,"role":["safety"],"when_to_use":"Retry transient failures, fall back, escalate.","when_not_to_use":"Deterministic errors.","inputs":["primary action","fallback policy"],"outputs":["result or error"],"failure_modes":["fallback on success","retrying invalid call"],"chains_with":["human-in-the-loop","guardrails"],"token_cost_estimate":227},
    {"id":"human-in-the-loop","name":"Human-in-the-Loop","chapter":13,"role":["safety"],"when_to_use":"Human confirmation at high stakes.","when_not_to_use":"Routine bulk decisions.","inputs":["proposed action","escalation channel"],"outputs":["approved action"],"failure_modes":["over-escalation","lost handoff context"],"chains_with":["guardrails","exception-handling"],"token_cost_estimate":231},
    {"id":"rag","name":"Knowledge Retrieval","chapter":14,"role":["memory"],"when_to_use":"Retrieve top-k chunks, ground the answer.","when_not_to_use":"Corpus fits in context.","inputs":["query","indexed chunks"],"outputs":["grounded answer"],"failure_modes":["bad chunking","irrelevant top-k"],"chains_with":["memory-management","reflection"],"token_cost_estimate":194},
    {"id":"a2a","name":"Inter-Agent Communication","chapter":15,"role":["executor","planner"],"when_to_use":"Delegate to remote agents via Agent Cards.","when_not_to_use":"Agents share a process.","inputs":["agent card","task message"],"outputs":["task result"],"failure_modes":["card overstates skills","sync timeout"],"chains_with":["multi-agent","exception-handling"],"token_cost_estimate":221},
    {"id":"resource-aware-optimization","name":"Resource-Aware Optimization","chapter":16,"role":["planner"],"when_to_use":"Route to the cheapest adequate model or path.","when_not_to_use":"One model meets budget.","inputs":["query","model tiers"],"outputs":["tiered answer"],"failure_modes":["hard query misclassed","no critique loop"],"chains_with":["routing","evaluation-monitoring"],"token_cost_estimate":192},
    {"id":"reasoning-techniques","name":"Reasoning Techniques","chapter":17,"role":["critic"],"when_to_use":"Explicit reasoning: CoT, ToT, ReAct.","when_not_to_use":"Lookups, formatting.","inputs":["problem","technique + budget"],"outputs":["trace + answer"],"failure_modes":["confident wrong chain","ToT cost explosion"],"chains_with":["reflection","tool-use"],"token_cost_estimate":188},
    {"id":"guardrails","name":"Guardrails and Safety","chapter":18,"role":["safety"],"when_to_use":"Screen inputs, tool args, outputs against policy.","when_not_to_use":"Never a single layer.","inputs":["policy","input, args, output"],"outputs":["verdict"],"failure_modes":["verdict as prose","over-blocking"],"chains_with":["human-in-the-loop","evaluation-monitoring"],"token_cost_estimate":225},
    {"id":"evaluation-monitoring","name":"Evaluation and Monitoring","chapter":19,"role":["critic"],"when_to_use":"Score accuracy, latency, cost with rubrics.","when_not_to_use":"Exact-match on open outputs.","inputs":["test cases","rubric"],"outputs":["scores"],"failure_modes":["exact-match on paraphrase","judge without rubric"],"chains_with":["learning-adaptation","reflection"],"token_cost_estimate":211},
    {"id":"prioritization","name":"Prioritization","chapter":20,"role":["planner"],"when_to_use":"Rank tasks by urgency, importance, deps, cost.","when_not_to_use":"One task or fixed order.","inputs":["tasks","criteria"],"outputs":["ordered tasks"],"failure_modes":["everything P0","stale ranking"],"chains_with":["planning","goal-setting"],"token_cost_estimate":200},
    {"id":"exploration-discovery","name":"Exploration and Discovery","chapter":21,"role":["planner","critic"],"when_to_use":"Generate, review, rank, evolve hypotheses.","when_not_to_use":"Well-defined problems.","inputs":["research goal","review criteria"],"outputs":["ranked hypotheses"],"failure_modes":["reviewer groupthink","unbounded rounds"],"chains_with":["reflection","planning"],"token_cost_estimate":211}
  ]
}
